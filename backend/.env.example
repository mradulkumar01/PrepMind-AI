# Copy to .env and edit. Never commit .env or put real credentials in this file.
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_ME_WITH_A_GENERATED_SECRET
JWT_EXPIRE_MINUTES=60

MONGO_URI=mongodb://localhost:27017
MONGO_DB=prepmind

CHROMA_PATH=./chroma_data
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=5

# LLM: "openai_compatible" (Ollama / llama.cpp server / vLLM / Groq...) or "mock"
# "mock"= deterministic heuristics for UI demos without a GPU. NOT an AI judgement.
LLM_PROVIDER=mock
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=not-needed

# Optional OpenAI-compatible Whisper endpoint. Keep blank to use text answers only.
SPEECH_TRANSCRIPTION_URL=
SPEECH_TRANSCRIPTION_MODEL=whisper-1
SPEECH_API_KEY=

# Optional sandboxed code execution (Judge0-compatible). Leave URL blank to disable Run/Submit.
# Example: https://judge0-ce.p.rapidapi.com (RapidAPI deployments also need API_KEY and HOST).
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_HOST=

# Comma-separated accounts allowed to manage arena problems and contests.
ARENA_ADMIN_EMAILS=
